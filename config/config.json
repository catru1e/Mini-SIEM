{
  "server": {
    "host": "127.0.0.1",
    "port": 6969,
    "db_path": "data/events.db"
  },
  "agent": {
    "log_paths": [
      "logs/demo_auth.log",
      "/var/log/auth.log",
      "/var/log/syslog",
      "/var/log/kern.log"
    ],
    "state_path": "data/agent_state.json",
    "agent_log_path": "logs/agent.log",
    "ssh_watch_path": "~/.ssh"
  },
  "detection": {
    "failed_login_threshold": 5,
    "failed_login_window_seconds": 300,
    "invalid_user_threshold": 5,
    "invalid_user_window_seconds": 300,
    "sudo_threshold": 3,
    "sudo_window_seconds": 300,
    "success_login_threshold": 10,
    "success_login_window_seconds": 120,
    "blacklisted_processes": [
      "nc",
      "netcat",
      "ncat",
      "socat"
    ]
  },
  "dashboard": {
    "events_limit_default": 100,
    "alerts_limit_default": 100,
    "events_limit_max": 0,
    "alerts_limit_max": 0
  },
  "auth": {
    "db_path": "data/auth.db",
    "session_cookie": "mini_siem_session",
    "session_ttl_seconds": 86400
  },
  "paths": {
    "data_dir": "data",
    "logs_dir": "logs"
  }
}
