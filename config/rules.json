  {
    "description": "Detected {{count}} successful logins for user {{group_key}} within {{window_sec}} seconds.",
    "enabled": true,
    "event_types": [
      "auth_success",
      "accepted_login"
    ],
    "group_by": "user",
    "id": "RULE_SUCCESS_LOGIN_USER",
    "severity": "medium",
    "source_types": [
      "auth"
    ],
    "suppress_sec": 60,
    "threshold": 10,
    "title": "Too many successful logins",
    "type": "threshold",
    "window_sec": 120
  },
  {
    "conditions": [
      {
        "field": "process_name",
        "op": "in",
        "values": [
          "nc",
          "netcat",
          "ncat",
          "socat"
        ]
      }
    ],
    "description": "Detected blacklisted process: {{group_key}}.",
    "enabled": true,
    "event_types": [
      "process_start"
    ],
    "group_by": "process_name",
    "id": "RULE_BLACKLISTED_PROCESS",
    "severity": "high",
    "source_types": [
      "process"
    ],
    "suppress_sec": 60,
    "title": "Blacklisted process started",
    "type": "match"
  },
  {
    "conditions": [
      {
        "field": "path",
        "op": "contains_any",
        "values": [
          "authorized_keys",
          "known_hosts",
          "config",
          "id_rsa",
          "id_ed25519"
        ]
      }
    ],
    "description": "Detected sensitive SSH file activity: {{event_type}} on {{group_key}}.",
    "enabled": true,
    "event_types": [
      "file_created",
      "file_modified",
      "file_deleted"
    ],
    "group_by": "path",
    "id": "RULE_SENSITIVE_SSH_FILE_CHANGE",
    "severity": "high",
    "source_types": [
      "file"
    ],
    "suppress_sec": 60,
    "title": "Sensitive SSH file changed",
    "type": "match"
  },
  {
    "conditions": [
      {
        "field": "raw",
        "op": "contains",
        "value": "apparmor=\"DENIED\""
      }
    ],
    "description": "Detected {{count}} AppArmor denied events for program {{group_key}} within {{window_sec}} seconds.",
    "enabled": true,
    "event_types": [
      "system_event"
    ],
    "group_by": "program",
    "id": "RULE_APPARMOR_DENIED",
    "severity": "medium",
    "source_types": [
      "syslog"
    ],
    "suppress_sec": 60,
    "threshold": 10,
    "title": "Repeated AppArmor denied events",
    "type": "threshold",
    "window_sec": 120
  },
  {
    "conditions": [
      {
        "field": "severity",
        "op": "in",
        "values": [
          "medium",
          "high"
        ]
      }
    ],
