[
  {
    "id": "RULE_FAILED_LOGIN_IP",
    "enabled": true,
    "type": "threshold",
    "event_types": ["auth_failed", "failed_login"],
    "source_types": ["auth"],
    "group_by": "src_ip",
    "threshold": 5,
    "window_sec": 300,
    "suppress_sec": 60,
    "severity": "high",
    "title": "Brute force from IP",
    "description": "Detected {{count}} failed login attempts from IP {{group_key}} within {{window_sec}} seconds."
  },
  {
    "id": "RULE_FAILED_LOGIN_USER",
    "enabled": true,
    "type": "threshold",
    "event_types": ["auth_failed", "failed_login"],
    "source_types": ["auth"],
    "group_by": "user",
    "threshold": 5,
    "window_sec": 300,
    "suppress_sec": 60,
    "severity": "high",
    "title": "Multiple failed logins for user",
    "description": "Detected {{count}} failed login attempts for user {{group_key}} within {{window_sec}} seconds."
  },
  {
    "id": "RULE_INVALID_USER_IP",
    "enabled": true,
    "type": "threshold",
    "event_types": ["auth_invalid_user", "invalid_user"],
    "source_types": ["auth"],
    "group_by": "src_ip",
    "threshold": 5,
    "window_sec": 300,
    "suppress_sec": 60,
    "severity": "medium",
    "title": "Invalid users from IP",
    "description": "Detected {{count}} invalid-user attempts from IP {{group_key}} within {{window_sec}} seconds."
  },
  {
    "id": "RULE_SUDO_FREQUENCY_USER",
    "enabled": true,
    "type": "threshold",
    "event_types": ["privilege_escalation"],
    "source_types": ["auth"],
    "group_by": "user",
    "threshold": 3,
    "window_sec": 300,
    "suppress_sec": 60,
    "severity": "medium",
    "title": "Suspicious sudo usage",
    "description": "Detected {{count}} privilege escalation events for user {{group_key}} within {{window_sec}} seconds."
  },
  {
    "id": "RULE_SUCCESS_LOGIN_USER",
    "enabled": true,
    "type": "threshold",
    "event_types": ["auth_success", "accepted_login"],
    "source_types": ["auth"],
    "group_by": "user",
    "threshold": 10,
    "window_sec": 120,
    "suppress_sec": 60,
    "severity": "medium",
    "title": "Too many successful logins",
    "description": "Detected {{count}} successful logins for user {{group_key}} within {{window_sec}} seconds."
  },
  {
    "id": "RULE_BLACKLISTED_PROCESS",
    "enabled": true,
    "type": "match",
    "event_types": ["process_start"],
    "source_types": ["process"],
    "group_by": "process_name",
    "suppress_sec": 60,
    "severity": "high",
    "title": "Blacklisted process started",
    "description": "Detected blacklisted process: {{group_key}}.",
    "conditions": [
      {
        "field": "process_name",
        "op": "in",
        "values": ["nc", "netcat", "ncat", "socat"]
      }
    ]
  },
  {
    "id": "RULE_SENSITIVE_SSH_FILE_CHANGE",
    "enabled": true,
    "type": "match",
    "event_types": ["file_created", "file_modified", "file_deleted"],
    "source_types": ["file"],
    "group_by": "path",
    "suppress_sec": 60,
    "severity": "high",
    "title": "Sensitive SSH file changed",
    "description": "Detected sensitive SSH file activity: {{event_type}} on {{group_key}}.",
    "conditions": [
      {
        "field": "path",
        "op": "contains_any",
        "values": ["authorized_keys", "known_hosts", "config", "id_rsa", "id_ed25519"]
      }
    ]
  },
  {
    "id": "RULE_APPARMOR_DENIED",
    "enabled": true,
    "type": "threshold",
    "event_types": ["system_event"],
    "source_types": ["syslog"],
    "group_by": "program",
    "threshold": 10,
    "window_sec": 120,
    "suppress_sec": 60,
    "severity": "medium",
    "title": "Repeated AppArmor denied events",
    "description": "Detected {{count}} AppArmor denied events for program {{group_key}} within {{window_sec}} seconds.",
    "conditions": [
      {
        "field": "raw",
        "op": "contains",
        "value": "apparmor=\"DENIED\""
      }
    ]
  },
  {
    "id": "RULE_KERNEL_ERROR",
    "enabled": true,
    "type": "match",
    "event_types": ["system_event"],
    "source_types": ["syslog"],
    "group_by": "program",
    "suppress_sec": 60,
    "severity": "medium",
    "title": "Kernel or system error message",
    "description": "Detected system error from {{group_key}}.",
    "conditions": [
      {
        "field": "severity",
        "op": "in",
        "values": ["medium", "high"]
      }
    ]
  }
]
